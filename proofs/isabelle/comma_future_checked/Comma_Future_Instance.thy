theory Comma_Future_Instance
  imports Comma_Future_Check.Comma_Future_Cycle_Check Comma_Future_Rank_Data.Comma_Rank_Data
begin

text \<open>The typed rank candidate is generated by the existing untrusted
 generate_rank_candidate.py. This instance checks semantic children through
 the same fast control as the decade totality checker. It supplies no candidate
 outcomes. The 28-round bound is evaluation fuel, with failure rejected; it
 is not an assumed termination theorem. The complete check below has not yet
 been discharged, and does not replace production forest admission.\<close>

definition comma_future_instance_check :: bool where
  "comma_future_instance_check =
    (comma_future_rank_check 28 comma_rank_candidate \<and>
     length (filter (\<lambda>q. comma_rank_candidate q \<noteq> None)
       comma_boundary_states) = 14470 \<and>
     length (filter (\<lambda>q. comma_rank_candidate q = None)
       comma_boundary_states) = 314 \<and>
     list_all (\<lambda>q. case comma_rank_candidate q of None \<Rightarrow> True
       | Some n \<Rightarrow> n\<le>136) comma_boundary_states \<and>
     list_ex (\<lambda>q. comma_rank_candidate q = Some 136) comma_boundary_states \<and>
     (case comma_fast_surviving_sources 314 28 comma_rank_candidate (Comma_N,2,10) of
        None \<Rightarrow> False
      | Some sources \<Rightarrow> distinct sources \<and>
          list_all (\<lambda>q. comma_boundary_valid q \<and> comma_rank_candidate q = None) sources) \<and>
     comma_rank_candidate (Comma_N,2,10) = None \<and>
     comma_fast_surviving_walk 314 28 comma_rank_candidate (Comma_N,2,10)
       = Some ((Comma_N,2,10),924))"

theorem comma_future_instance_rank_sound:
  assumes "comma_future_instance_check"
  shows "comma_rank_witness comma_total_children (set comma_boundary_states)
    comma_rank_candidate"
  using assms comma_future_rank_check_sound[of 28 comma_rank_candidate]
  by (simp add: comma_future_instance_check_def)

theorem comma_future_instance_cycle_sound:
  assumes "comma_future_instance_check"
  shows "comma_surviving_delta_path comma_rank_candidate 314
    (Comma_N,2,10) (Comma_N,2,10) 924"
  by (rule comma_fast_surviving_walk_sound[where rounds=28])
    (use assms in \<open>simp add: comma_future_instance_check_def\<close>)

corollary comma_future_instance_repeated_returns:
  assumes "comma_future_instance_check"
  shows "comma_surviving_delta_path comma_rank_candidate (k*314)
    (Comma_N,2,10) (Comma_N,2,10) (k*924)"
  by (rule comma_surviving_cycle_repeats[OF comma_future_instance_cycle_sound[OF assms]])

theorem comma_future_instance_rank_maximum:
  assumes checked: "comma_future_instance_check"
  shows "\<forall>q\<in>set comma_boundary_states. \<forall>n.
      comma_rank_candidate q = Some n \<longrightarrow> n\<le>136"
    and "\<exists>q\<in>set comma_boundary_states. comma_rank_candidate q = Some 136"
  using checked by (auto simp: comma_future_instance_check_def list_all_iff list_ex_iff
    split: option.splits)

theorem comma_future_instance_distinct_cycle:
  assumes checked: "comma_future_instance_check"
  shows "\<exists>sources. length sources=314 \<and> distinct sources \<and>
    set sources \<subseteq> {q. comma_boundary_valid q \<and> comma_rank_candidate q = None} \<and>
    (\<forall>i<314. \<exists>delta. comma_surviving_delta_path comma_rank_candidate i
      (Comma_N,2,10) (sources ! i) delta)"
proof -
  obtain sources where computed:
      "comma_fast_surviving_sources 314 28 comma_rank_candidate (Comma_N,2,10) = Some sources"
    and distinct: "distinct sources"
    and valid: "list_all (\<lambda>q. comma_boundary_valid q \<and> comma_rank_candidate q = None) sources"
    using checked by (auto simp: comma_future_instance_check_def split: option.splits)
  have length: "length sources=314"
    by (rule comma_fast_surviving_sources_length[OF computed])
  have prefixes: "\<forall>i<314. \<exists>delta. comma_surviving_delta_path comma_rank_candidate i
      (Comma_N,2,10) (sources ! i) delta"
    using comma_fast_surviving_sources_sound[OF computed] by blast
  show ?thesis using length distinct valid prefixes
    by (auto simp: list_all_iff)
qed

corollary comma_future_instance_exact_losing_level:
  assumes checked: "comma_future_instance_check"
  shows "comma_losing_levels comma_total_children (set comma_boundary_states) 136 =
    {q\<in>set comma_boundary_states. comma_rank_candidate q \<noteq> None}"
  by (rule comma_rank_witness_exact_fixed_point[OF comma_future_instance_rank_sound[OF checked]])
    (use comma_future_instance_rank_maximum(1)[OF checked] in blast)

text \<open>Even a future closed theorem proving comma_future_instance_check
 would leave the positive literal weighted return and source-20 connection
 as mandatory separate gates. Earlier-root exclusion is also not supplied here;
 these checks do not assert that source 20 is the globally first surviving root.
 Quotient return is not a weight certificate.\<close>
ML \<open>
  val _ = if null (Thm_Deps.all_oracles
    @{thms comma_future_instance_rank_sound comma_future_instance_cycle_sound
      comma_future_instance_repeated_returns comma_future_instance_rank_maximum
      comma_future_instance_distinct_cycle comma_future_instance_exact_losing_level})
    then () else error "Comma future instance soundness depends on an oracle";
\<close>
end
